# Copy to .env (git-ignored). Only used by the local throwaway containers in docker-compose.yml.
# SQL Server requires a "strong" password: 8+ characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Labs_Local_Only_123!

# Connection strings the labs read (they match docker-compose.yml).
ConnectionStrings__Sql=Server=localhost,14330;Database=Labs;User Id=sa;Password=Labs_Local_Only_123!;TrustServerCertificate=True
ConnectionStrings__Redis=localhost:63790
